# Copy this file to .env, then paste your own DeepSeek API key after the = sign.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_ID=deepseek-v4-flash

# Local mode is the default. Preview mode is explicit and requires all of:
# XIAOG_RUNTIME_MODE=preview
# XIAOG_DATA_DIR=/isolated/preview/data
# XIAOG_RELEASE_ID=<immutable-release-identity>
# XIAOG_HOST=127.0.0.1
# XIAOG_PORT=8000
# XIAOG_PREVIEW_PROVIDER_ALLOWLIST=deepseek

# Optional: set to DEBUG while learning. Do not put secrets in log files.
LOG_LEVEL=INFO
