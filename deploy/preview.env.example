# Preview release contract. Values are placeholders; do not commit real secrets.
XIAOG_RUNTIME_MODE=preview
XIAOG_HOST=0.0.0.0
XIAOG_PORT=8000
XIAOG_DATA_DIR=/var/lib/xiaog-preview
XIAOG_LOG_DIR=/var/log/xiaog-preview
# Both values must match the deterministic WP-4 release manifest.
XIAOG_SOURCE_REVISION=<full-immutable-git-commit>
XIAOG_RELEASE_ID=xiaog-preview-<full-immutable-git-commit>
XIAOG_PREVIEW_PROVIDER_ALLOWLIST=deepseek
XIAOG_PREVIEW_INVITES=<server-side-invite-secret-json-only>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_ID=deepseek-v4-flash
DEEPSEEK_API_KEY=<server-side-secret-injection-only>
