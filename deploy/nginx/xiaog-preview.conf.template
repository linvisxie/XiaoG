# WP-5B External Preview gateway template. Render before installing.
# This file belongs inside nginx's http context (for example, conf.d/).
# It contains no secret values. Keep XiaoG bound only to 127.0.0.1:8000.

map $http_upgrade $xiaog_connection_upgrade {
    default upgrade;
    ''      '';
}

# Do not use $request, $request_body, $http_cookie, $http_authorization, or
# query strings here: they can contain Preview credentials or session material.
log_format xiaog_preview_safe '$remote_addr $status $request_method $uri '
                              '$body_bytes_sent $request_time '
                              '$upstream_response_time';

# Limit only credential-exchange attempts. XiaoG retains the per-invite and
# global request/generation quotas after a session is established.
limit_req_zone $binary_remote_addr zone=xiaog_preview_access:10m rate=10r/m;

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name __XIAOG_PUBLIC_HOST__;
    return 308 https://__XIAOG_PUBLIC_HOST__$request_uri;
}

server {
    listen 443 ssl http2 default_server;
    server_name _;
    ssl_certificate __TLS_CERTIFICATE_PATH__;
    ssl_certificate_key __TLS_PRIVATE_KEY_PATH__;
    return 444;
}

server {
    listen 443 ssl http2;
    server_name __XIAOG_PUBLIC_HOST__;

    ssl_certificate __TLS_CERTIFICATE_PATH__;
    ssl_certificate_key __TLS_PRIVATE_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:xiaog_preview_tls:10m;
    ssl_session_timeout 1d;

    server_tokens off;
    client_max_body_size 64k;
    access_log /var/log/nginx/xiaog-preview.access.log xiaog_preview_safe;
    error_log /var/log/nginx/xiaog-preview.error.log warn;

    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # The credential exchange is deliberately rate-limited before it reaches
    # XiaoG. It must never be included in access logs.
    location = /api/preview/access {
        limit_req zone=xiaog_preview_access burst=3 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Includes normal HTML/API responses and text/event-stream chat output.
    # Disabling buffering preserves XiaoG's SSE deltas and its upstream
    # X-Accel-Buffering: no contract.
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Connection $xiaog_connection_upgrade;
        proxy_set_header Upgrade $http_upgrade;
    }
}
